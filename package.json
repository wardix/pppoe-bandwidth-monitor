{
  "name": "pppoe-bandwidth-monitor",
  "version": "1.0.0",
  "description": "Prometheus exporter for monitoring PPPoE bandwidth limits on MikroTik vs DB Gateway",
  "main": "server.ts",
  "type": "module",
  "scripts": {
    "start": "bun run server.ts",
    "dev": "bun run --watch server.ts",
    "format": "biome format --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "hono": "^4.12.15"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@types/bun": "latest",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  },
  "lint-staged": {
    "*.{ts,js,json,md}": "biome format --write"
  }
}
